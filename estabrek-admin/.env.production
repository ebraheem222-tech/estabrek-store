# The live shop, for the new editor's preview and the store themes page.
# A value set in the Cloudflare Pages project settings wins over this file.
VITE_STOREFRONT_BASE_URL=https://estabrek-store.vercel.app

# The platform's own server: an admin put up with no server of its own (a client copy's, before anything is
# linked) asks it to make the database, the server and the shop (src/features/connect, backend lib/siteAsk.ts).
VITE_PLATFORM_API_URL=https://estabrek-store-production.up.railway.app/v1
