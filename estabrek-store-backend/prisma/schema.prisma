generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ===================== Enums =====================
 */
enum Locale {
  ar
  he
  en
}

enum Role {
  /// Store owner: every permission, can manage other owners.
  SUPERADMIN
  /// Team member: permissions come from their StaffRole.
  STAFF
}

enum AdminStatus {
  ACTIVE
  /// Invited, has not set a password yet.
  INVITED
  SUSPENDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderReqStatus {
  NEW
  CONTACTED
  ACCEPTED
  REJECTED
  SHIPPED
  CLOSED
  CANCELED
  REFUNDED
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NavLocation {
  HEADER
  FOOTER
  SECONDARY
  CUSTOM
}

enum PageSectionType {
  HERO
  RICH_TEXT
  CUSTOM_HTML
  GRID
  FEATURES
  STATS
  TEAM
  PRICING
  CONTACT
  BANNER
  FEATURED_CATEGORIES
  COLLECTIONS_GRID
  BEST_SELLERS_SLIDER
  NEW_ARRIVALS_SLIDER
  BRANDS_SLIDER
  FEATURED_PRODUCTS
  IMAGE_GALLERY
  FAQ
  TESTIMONIALS
  CTA
  CARDS
  VIDEO
  NEWSLETTER
}

enum TwoFactorMethod {
  TOTP
  SMS
  EMAIL
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  MFA_CHALLENGE_SUCCESS
  MFA_CHALLENGE_FAILURE
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  PHONE_CHANGED
  SESSION_CREATED
  SESSION_REVOKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  /// Signed in from an IP this admin hasn't used before.
  NEW_DEVICE_LOGIN
}



enum AdminOtpPurpose {
  MFA_SMS
  PHONE_LOGIN
  ENABLE_SMS_2FA
  PHONE_VERIFY
}


enum CouponDiscountType {
  PERCENT
  FIXED
}
/**
 * ============ Single Admin + Security/Auth ============
 */
model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  role         Role   @default(SUPERADMIN)
  status       AdminStatus @default(ACTIVE)
  /// For STAFF accounts: what they may do. Owners (SUPERADMIN) ignore it.
  staffRoleId  String?
  staffRole    StaffRole?  @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  invitedById  String?

  emailVerifiedAt DateTime?
  phone           String?
  phoneVerifiedAt DateTime?
  secondEmail     String?
  secondPhone     String?

  twoFactorEnabled Boolean @default(false)

  // one-to-one pointer to the default 2FA device
  default2FADeviceId String?         @unique
  default2FADevice   Admin2FADevice? @relation("AdminUserDefault2FA", fields: [default2FADeviceId], references: [id], onDelete: SetNull)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastIp           String?

  // other relations
  sessions       AdminSession[]
  twoFADevices   Admin2FADevice[]
  recoveryCodes  Admin2FARecoveryCode[]
  securityEvents AdminSecurityEvent[]
  passwordResets AdminPasswordReset[]
  emailChanges   AdminEmailChange[]
  otpChallenges  AdminOtpChallenge[]

  inventoryAdjustments InventoryAdjustment[]
  settingsRevisions    SettingsRevision[]
  auditLogs            AdminAuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([staffRoleId])
}

/// A named set of permissions for team members (e.g. "طلبات وخدمة الزبائن").
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Permission keys, e.g. "orders:read", "orders:write" (see src/modules/admin/permissions.ts).
  permissions String[] @default([])
  members     AdminUser[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Server & security rules set from the admin (one row, id "default").
/// Unset values fall back to the environment variables.
model SecurityPolicy {
  id          String   @id @default("default")
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// The policy as it was before each change (latest 30 kept).
/// An IP blocked by hand from the admin (traffic page). until = null → until unblocked.
model IpBlock {
  id          String    @id @default(cuid())
  ip          String    @unique
  reason      String?
  until       DateTime?
  adminUserId String?
  createdAt   DateTime  @default(now())

  @@index([until])
}

model SecurityPolicyRevision {
  id          String   @id @default(cuid())
  data        Json
  changed     String[] @default([])
  adminUserId String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Every change made from the admin: who, what, when, from where.
model AdminAuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  /// Area of the admin, e.g. "orders", "catalog", "settings", "staff".
  area        String
  /// create | update | delete | action
  verb        String
  method      String
  /// Path with ids replaced, e.g. "/orders/:id/status".
  path        String
  targetId    String?
  status      Int
  /// Names of the fields that were sent (never their values).
  fields      String[]   @default([])
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([adminUserId, createdAt])
  @@index([area, createdAt])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  refreshTokenHash String?       @unique
  ip               String?
  userAgent        String?
  status           SessionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?

  @@index([adminUserId, status])
  @@index([expiresAt])
}

model AdminPasswordReset {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  // Reset token is sent as "tokenId.secret" (we store only a hash of the secret)
  tokenId   String @unique
  tokenHash String

  expiresAt   DateTime
  usedAt      DateTime?
  requesterIp String?
  requesterUa String?
  createdAt   DateTime @default(now())

  @@index([adminUserId, expiresAt])
  @@index([tokenId, expiresAt])
}

model AdminOtpChallenge {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  purpose AdminOtpPurpose
  channel Channel @default(SMS)
  to      String

  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attempts     Int      @default(0)
  requesterIp  String?
  requesterUa  String?
  createdAt    DateTime @default(now())

  @@index([adminUserId, purpose, expiresAt])
  @@index([to, purpose, expiresAt])
}

model AdminEmailChange {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([adminUserId, newEmail])
}

model Admin2FADevice {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  // ⬇️ back-relation for the named one-to-one above
  defaultFor AdminUser? @relation("AdminUserDefault2FA")

  label         String?
  method        TwoFactorMethod
  totpSecretEnc String?
  targetPhone   String?
  targetEmail   String?

  enabled    Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([adminUserId, method])
}

model Admin2FARecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminUserId])
}

model AdminSecurityEvent {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  type      SecurityEventType
  ip        String?
  userAgent String?
  metadata  Json?
  at        DateTime          @default(now())

  @@index([adminUserId, type, at])
}

/**
 * ============ Site Settings / Menus / Pages ============
 */
model SiteSettings {
  id         String  @id @default(cuid())
  siteName   String  @default("My Store")
  currencyCode String @default("ILS")
  storeCountryCode String @default("IL")
  logoUrl    String?
  faviconUrl String?

  // Global announcement bar (Top Bar)
  announcementIsActive Boolean @default(false)
  announcementText     String?
  announcementLinkUrl  String?

  header Json?
  footer Json?

  // Shopper accounts on the storefront (sign in, orders, favourites, addresses). Off = visitors only.
  customerAccountsEnabled Boolean @default(false)
  // "Tell me when it's back" on sold-out sizes (email). Off = the form isn't shown.
  stockAlertsEnabled Boolean @default(false)
  // Maintenance mode: the storefront shows a "back soon" screen and public orders are paused.
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?
  /** Opens the storefront for the owner while maintenance is on (?preview=<key>). */
  maintenanceKey     String?
  // Daily automatic backup of the database (admin → النسخ الاحتياطي).
  backupsEnabled     Boolean @default(true)

  // Newsletter
  newsletterIsActive Boolean @default(false)
  newsletterTitle    String?
  newsletterText     String?
  newsletterSuccess  String?

  primaryNavId String?
  primaryNav   NavigationMenu? @relation("PrimaryNav", fields: [primaryNavId], references: [id], onDelete: SetNull)

  footerNavId String?
  footerNav   NavigationMenu? @relation("FooterNav", fields: [footerNavId], references: [id], onDelete: SetNull)

  scriptsHead Json?
  scriptsBody Json?
  customCss   String?

  contactEmail String?
  contactPhone String?

  // Checkout & Payments
  checkoutMode String @default("WHATSAPP")
  ordersEmail String?
  whatsappNumber String?

  stripeEnabled Boolean @default(false)
  stripePublicKey String?
  stripeSecretKey String?
  stripeWebhookSecret String?

  paypalEnabled Boolean @default(false)
  paypalClientId String?
  paypalClientSecret String?
  paypalWebhookId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The site settings as they were before each save, to look back and restore with one click.
/// Payment secrets are never copied here.
model SettingsRevision {
  id          String     @id @default(cuid())
  data        Json
  /// What changed in that save (top-level keys), for the list in the admin.
  changed     Json?
  note        String?
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}

model NavigationMenu {
  id        String      @id @default(cuid())
  name      String
  location  NavLocation @default(CUSTOM)
  isDefault Boolean     @default(false)

  items NavigationItem[]

  // back-relations for the named relations above:
  usedAsPrimary SiteSettings[] @relation("PrimaryNav")
  usedAsFooter  SiteSettings[] @relation("FooterNav")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, location])
  @@index([location, isDefault])
}

model NavigationItem {
  id     String         @id @default(cuid())
  menuId String
  menu   NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  parentId String?
  parent   NavigationItem?  @relation("NavItemChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavItemChildren")

  label      String
  href       String
  target     String?
  icon       String?
  order      Int     @default(0)
  isActive   Boolean @default(true)
  isExternal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId, parentId, order])
  @@index([menuId, isActive])
}

model Page {
  id     String     @id @default(cuid())
  name   String
  slug   String     @unique // "/", "/about", etc.
  status PageStatus @default(DRAFT)
  publishAt   DateTime?
  unpublishAt DateTime?

  sections PageSection[]
  translations PageTranslation[]
  revisions PageRevision[]

  headScripts Json?
  bodyScripts Json?
  customCss   String?
  canonicalUrl String?

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  noIndex        Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, slug])
  @@index([status, publishAt, unpublishAt])
}

model PageRevision {
  id        String @id @default(cuid())
  pageId    String
  page      Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  name      String
  slug      String
  status    PageStatus
  publishAt DateTime?
  unpublishAt DateTime?

  canonicalUrl   String?
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  noIndex        Boolean @default(false)
  customCss      String?
  headScripts    Json?
  bodyScripts    Json?

  sections  Json
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

/**
 * ====================== Media Library ======================
 */
model MediaAsset {

  id          String   @id @default(cuid())
  kind        String   @default("IMAGE")

  /** stored filename on disk (uploads/images/<filename>) */
  filename    String   @unique

  /** absolute public URL (e.g. Cloudinary secure_url). Optional for local-disk provider. */
  url         String?

  /** storage provider (LOCAL | CLOUDINARY) */
  provider    String   @default("LOCAL")

  /** provider identifier (e.g. Cloudinary public_id). Optional. */
  providerId  String?

  /** user-friendly name shown in admin UI (renaming doesn't break URLs) */
  displayName String?

  /** optional folder name for organization (e.g. "home", "products", "hero") */
  folder      String?

  /** free-form tags */
  tags        String[] @default([])

  mime        String
  size        Int
  width       Int?
  height      Int?
  imageHash   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

/** dominant color extracted for UX grouping / swatches */
dominantColorHex String?
/** palette extracted (array of hex strings) */
palette          Json?
  /** low-res placeholder (base64 data URL) */
  blurDataUrl      String?
  @@index([folder])
  @@index([kind, folder, createdAt])
  @@index([imageHash])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageSection {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type      PageSectionType
  data      Json
  order     Int             @default(0)
  isVisible Boolean         @default(true)

  translations PageSectionTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

/**
 * ================== Storefront Users ==================
 */
/// A shopper's account (optional: buying as a guest still works).
model User {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String   @unique
  phone     String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  /// Agreed to news and offers by email.
  marketingOptIn  Boolean   @default(false)
  preferredSize   String?
  /// Hex colour she picked on the site; the rose design opens in it.
  favoriteColor   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews  Review[]
  comments ProductComment[]
  chatbotConversations ChatbotConversation[]
  sessions  CustomerSession[]
  wishlist  WishlistItem[]
  addresses Address[]
  orders    OrderRequest[]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// One-time sign-in codes sent by email.
model CustomerOtp {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// A signed-in device. The refresh token is stored hashed.
model CustomerSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  phone     String
  city      String
  address   String
  notes     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/**
 * ====================== Catalog ======================
 */
model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  iconUrl   String?
  parentId  String?
  parent    Category?  @relation("CategoryToChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToChildren")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String?
  /// Search-engine title and description (the page falls back to the title and description).
  seoTitle       String?
  seoDescription String?
  /** semantic search embedding (vector as JSON array) */
  embedding        Json?
  /** text used to generate embedding */
  embeddingText    String?
  /** embedding model id */
  embeddingModel   String?
  /** last embedding timestamp */
  embeddingUpdatedAt DateTime?
  isActive    Boolean          @default(true)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// The kind of product (clothes, ticket, course…) and its own fields' values: { fieldKey: value }.
  typeId      String?
  type        ProductType?     @relation(fields: [typeId], references: [id], onDelete: SetNull)
  attributes  Json?
  /// Bookings (tickets, courses): when and where. Shown on the product page and the ticket.
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  eventLocation String?
  /// Digital products: the files the shopper downloads after paying / acceptance.
  files       ProductFile[]
  tickets     Ticket[]
  requests        CustomerRequest[] @relation("RequestProduct")
  linkedRequests  CustomerRequest[] @relation("RequestLinkedProduct")
  items       ProductItem[]
  reviews     Review[]
  comments    ProductComment[]
  wishlistedBy WishlistItem[]
  stockAlerts  StockAlert[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([isActive, categoryId])
  @@index([isActive, createdAt])
  @@index([typeId])
}

/**
 * A kind of product with its own fields, made by the owner in the admin
 * (أنواع المنتجات): e.g. clothes (fabric, length, care, occasion), a ticket
 * (from, to, date) or a course (hours, link). Values live in Product.attributes.
 */
model ProductType {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  /// [{ key, label, kind, unit?, options?, required?, filterable?, showOnPage?, help? }]
  fields      Json      @default("[]")
  /// What the two choices are called for this kind ("اللون"/"المقاس", or e.g. "الدرجة"), and whether they show.
  colorLabel  String    @default("اللون")
  sizeLabel   String    @default("المقاس")
  showColor   Boolean   @default(true)
  showSize    Boolean   @default(true)
  /// How it reaches the shopper: shipped, downloaded, or a booking with a ticket.
  fulfillment Fulfillment @default(SHIPPING)
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Fulfillment {
  SHIPPING
  DIGITAL
  BOOKING
}

/// A file of a digital product: a private upload, or an outside link (big files).
model ProductFile {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  /// "upload" (private file in storage) or "link" (an outside address).
  kind      String          @default("upload")
  location  String?
  url       String?
  bytes     Int?
  format    String?
  position  Int             @default(0)
  downloads OrderDownload[]
  createdAt DateTime        @default(now())

  @@index([productId])
}

/// How many times an order downloaded a file (there is a limit per file).
model OrderDownload {
  id             String       @id @default(cuid())
  orderRequestId String
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  fileId         String
  file           ProductFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  count          Int          @default(0)
  lastAt         DateTime?

  @@unique([orderRequestId, fileId])
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

/// One seat of a booking: made when the order is paid online or accepted.
model Ticket {
  id             String       @id @default(cuid())
  /// Shown and scanned at the door (XXXX-XXXX).
  code           String       @unique
  orderRequestId String
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  orderItemId    String?
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  /// What the seat is (variant snapshot, e.g. "VIP").
  label          String?
  holderName     String?
  status         TicketStatus @default(VALID)
  checkedInAt    DateTime?
  checkedInById  String?
  createdAt      DateTime     @default(now())

  @@index([orderRequestId])
  @@index([productId, status])
}

model ProductItem {
  id        String             @id @default(cuid())
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName String
  /** label to distinguish same-color items (e.g., box/packaging) */
  boxLabel  String             @default("")
  colorHex  String?
  // Palette extracted / suggested for UI swatches (array of hex strings)
  suggestedColors Json?
  skuBase   String
  isActive  Boolean            @default(true)
  images    ProductItemImage[]
  variants  ProductVariant[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([productId, colorName, boxLabel])
  @@index([productId, isActive])
  @@index([colorName])
}

model Size {
  id       String           @id @default(cuid())
  name     String           @unique
  order    Int              @default(0)
  active   Boolean          @default(true)
  variants ProductVariant[]
}

model ProductVariant {
  id            String      @id @default(cuid())
  productItemId String
  item          ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  sizeId        String
  size          Size        @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  sku           String      @unique
  price         Decimal     @db.Decimal(10, 2)
  compareAt     Decimal?    @db.Decimal(10, 2)
  /** Original price before scheduled sale (optional) */
  originalPrice Decimal?    @db.Decimal(10, 2)
  /** Scheduled sale price (optional) */
  salePrice     Decimal?    @db.Decimal(10, 2)
  /** Sale window start (optional) */
  saleStartsAt  DateTime?
  /** Sale window end (optional) */
  saleEndsAt    DateTime?
  stock         Int         @default(0)
  lowStockThreshold Int     @default(0)
  weightGrams   Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  inventoryAdjustments InventoryAdjustment[]
  orderRequests OrderRequest[]
  orderRequestItems OrderRequestItem[]
  stockAlerts StockAlert[]
  @@unique([productItemId, sizeId])
  @@index([productItemId])
  @@index([sizeId])
  @@index([price])
  @@index([salePrice])
  @@index([stock])
}
model InventoryAdjustment {
  id          String        @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  delta       Int
  beforeStock Int
  afterStock  Int
  reason      String?

  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([variantId])
  @@index([adminUserId])
  @@index([createdAt])
}

model ProductItemImage {

  id            String      @id @default(cuid())
  productItemId String
  item          ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  url           String
  alt           String?
  position      Int         @default(0)
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())

/** optional view role e.g. front/back/side/detail */
view             String?
/** dominant color extracted at upload time */
dominantColorHex String?
/** palette extracted (array of hex strings) */
palette          Json?
/** low-res placeholder (base64 data URL) */
blurDataUrl      String?
/** perceptual hash for deduplication */
imageHash       String?
/** image embedding (vector as JSON array) */
embedding        Json?
/** text used to generate embedding */
embeddingText    String?
/** embedding model id */
embeddingModel   String?
/** last embedding timestamp */
embeddingUpdatedAt DateTime?
  @@index([productItemId])
}

/**
 * ====================== UGC ======================
 */
model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([productId])
  @@index([status, createdAt])
}

model ProductComment {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([productId])
  @@index([status, createdAt])
}

/**
 * =========== Order Requests + Outbox/History ===========
 */
model OrderRequest {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity     Int            @default(1)

  // snapshot pricing at request time (helps reporting + coupons)
  unitPrice      Decimal? @db.Decimal(10, 2)
  subtotal       Decimal? @db.Decimal(10, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  total          Decimal? @db.Decimal(10, 2)

  currencyCode   String   @default("ILS")

  items          OrderRequestItem[]

  couponId   String?
  coupon     Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?
  couponRedemption CouponRedemption?

  /// The shopper's account, when she was signed in.
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  phone        String
  whatsapp     String?
  /// For digital products and tickets: where the delivery email goes (optional).
  email        String?
  /// Private link to the order's downloads and tickets (/order/<token>).
  accessToken  String?        @unique
  /// When the files/tickets were released (online payment or acceptance).
  deliveredAt  DateTime?
  deliveryEmailAt DateTime?
  tickets      Ticket[]
  downloads    OrderDownload[]
  country      String?
  city         String?
  address      String?
  note         String?
  status       OrderReqStatus @default(NEW)
  source       String?
  paymentProvider String?
  paymentStatus   String?
  paymentReference String?
  contactedAt  DateTime?
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  stockCommitted   Boolean        @default(false)
  stockCommittedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages OutboxMessage[]
  history  OrderRequestHistory[]

  @@index([status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model CheckoutSession {
  id         String   @id @default(cuid())
  provider   String
  status     String   @default("PENDING")
  payload    Json
  sessionRef String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([provider, status])
  @@index([sessionRef])
}

model OutboxMessage {
  id             String        @id @default(cuid())
  channel        Channel
  to             String
  template       String?
  payloadJson    Json?
  status         OutboxStatus  @default(QUEUED)
  lastError      String?
  orderRequestId String?
  orderRequest   OrderRequest? @relation(fields: [orderRequestId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([status, createdAt])
}

model OrderRequestHistory {
  id             String          @id @default(cuid())
  orderRequestId String
  orderRequest   OrderRequest    @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  fromStatus     OrderReqStatus?
  toStatus       OrderReqStatus
  note           String?
  at             DateTime        @default(now())

  @@index([orderRequestId])
}

model OrderRequestItem {
  id             String         @id @default(cuid())
  orderRequestId String
  orderRequest   OrderRequest   @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity     Int     @default(1)

  // snapshot pricing at request time
  unitPrice    Decimal @db.Decimal(10, 2)
  lineSubtotal Decimal @db.Decimal(10, 2)

  // snapshot product context (for stable order viewing even if catalog changes)
  productId    String
  productTitle String
  productSlug  String?
  itemId       String?
  colorName    String?
  colorHex     String?
  sizeId       String?
  sizeName     String?
  sku          String?
  imageUrl     String?

  createdAt DateTime @default(now())

  @@index([orderRequestId])
  @@index([variantId])
}

/**
 * =========== Coupons ==========
 * Admin-only for now (CRUD). Apply logic can be added later in storefront/checkout.
 */
model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  usageLimit Int?
  usedCount  Int      @default(0)

  // discount definition
  discountType  CouponDiscountType @default(PERCENT)
  discountValue Decimal            @db.Decimal(10, 2) @default(0)
  // for percent discounts, optionally cap
  maxDiscount   Decimal?           @db.Decimal(10, 2)
  minCart    Decimal? @db.Decimal(10, 2)
  /// Only this phone (its last 9 digits) can use it, e.g. a prize from the questions quiz.
  phone      String?
  isActive   Boolean  @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  note       String?

  // relations
  orderRequests OrderRequest[]
  redemptions   CouponRedemption[]
  quizWins      QuizWin[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([code])
}


model CouponRedemption {
  id             String       @id @default(cuid())
  couponId       String
  coupon         Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderRequestId String       @unique
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  phone          String?
  redeemedAt     DateTime     @default(now())

  @@index([couponId])
  @@index([redeemedAt])
}



model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // e.g. "footer", "newsletter_section"
  createdAt DateTime @default(now())

  @@index([createdAt])
}


model PageTranslation {
  id      String @id @default(cuid())
  pageId  String
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  locale Locale

  // SEO overrides per locale
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean?

  // Optional per-locale scripts/styles
  headScripts Json?
  bodyScripts Json?
  customCss   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, locale])
}

model PageSectionTranslation {
  id        String @id @default(cuid())
  sectionId String
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  locale Locale
  data   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, locale])
}

/**
 * ====================== Chatbot / Support Assistant ======================
 * Admin manages a knowledge base; Storefront can query it via /v1/storefront/chatbot.
 */
model ChatbotEntry {
  id        String @id @default(cuid())
  locale    Locale @default(ar)

  /** short title / question */
  title     String
  /** answer text (markdown/plain) */
  answer    String
  tags      String[] @default([])
  isEnabled Boolean  @default(true)
  /** higher = more likely to be used when multiple matches */
  priority  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, isEnabled, priority])
}

model ChatbotConversation {
  id        String @id @default(cuid())

  /** client-generated id stored in localStorage/cookie */
  sessionId String?

  /** optional link to registered storefront user */
  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  source  String @default("storefront")
  status  String @default("OPEN")

  /** Array<{ role: "user"|"assistant", content: string, at: string }> */
  messages Json

  // convenience fields for admin list
  lastMessage String?
  lastRole    String?
  lastAt      DateTime?

  // lightweight context
  pageUrl   String?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
}

/**
 * ===================== Back-in-stock alerts =====================
 * A shopper (no account needed) leaves her email on a sold-out size; when the
 * size has stock again she gets one email. The stop link (token) cancels it.
 */
enum StockAlertStatus {
  WAITING
  SENT
  CANCELLED
  FAILED
}

model StockAlert {
  id         String           @id @default(cuid())
  email      String
  variantId  String
  variant    ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  status     StockAlertStatus @default(WAITING)
  /** For the stop link in the email. */
  token      String           @unique
  attempts   Int              @default(0)
  ip         String?
  notifiedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([email, variantId])
  @@index([status, variantId])
  @@index([productId])
  @@index([ip, createdAt])
}

/**
 * ===================== Backups =====================
 * One row per backup (daily automatic or taken by hand). The file itself is
 * encrypted and stored off the server (Cloudinary, private).
 */
enum BackupStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model BackupRun {
  id          String       @id @default(cuid())
  status      BackupStatus @default(RUNNING)
  /** "auto" or "manual". */
  trigger     String
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  sizeBytes   Int?
  tables      Int?
  rows        Int?
  /** Rows per table. */
  counts      Json?
  /** Where the file is ("cloudinary"), and its id there; null once removed (older than the kept ones). */
  storage     String?
  location    String?
  fileName    String?
  error       String?
  adminUserId String?

  @@index([status, startedAt])
}

/// How often Razan (the storefront guide) was used, per day — counts only, no personal data.
model RazanStat {
  day   DateTime @db.Date
  key   String
  count Int      @default(0)

  @@id([day, key])
}

enum RequestKind {
  SIZE
  COLOR
  NEW_PIECE
  CALLBACK
}

enum RequestStatus {
  NEW
  SEARCHING
  FOUND
  UNAVAILABLE
  DONE
}

/// A shopper's request to the shop: a size/colour/piece it doesn't carry (with
/// photos), or "call me back" from Razan's guided ordering.
model CustomerRequest {
  id              String        @id @default(cuid())
  kind            RequestKind
  status          RequestStatus @default(NEW)
  name            String
  phone           String
  email           String?
  /// The piece she was looking at, if any.
  productId       String?
  product         Product?      @relation("RequestProduct", fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  wantedSize      String?
  wantedColor     String?
  details         String?
  /// Private photos: [{ location, bytes, format }] (deleted after the owner's days).
  photos          Json          @default("[]")
  photosDeletedAt DateTime?
  source          String?
  /// The owner found it: the product she can buy, and when she was told.
  linkedProductId String?
  linkedProduct   Product?      @relation("RequestLinkedProduct", fields: [linkedProductId], references: [id], onDelete: SetNull)
  notifiedAt      DateTime?
  adminNote       String?
  ip              String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([phone])
}


/* ---------------- «سؤال وجواب»: questions quiz with a coupon prize ---------------- */

/// A question the owner approved for the quiz (easy → hard by level).
model QuizQuestion {
  id        String   @id @default(cuid())
  text      String
  /// The choices, in order (2–4).
  choices   Json
  /// Index of the right choice.
  answer    Int
  /// 1 easy, 2 medium, 3 hard.
  level     Int      @default(1)
  topic     String   @default("general")
  /// Only approved questions are asked.
  approved  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved, active, level])
}

/// One device in one period (the counter of unique visitors; reset each period).
model QuizDevice {
  period    String
  device    String
  /// Its place among this period's devices (1, 2, 3…).
  seq       Int
  /// Gets a chance to play (counter: seq is 1, 3, 7, 15…; chance mode: a draw).
  chance    Boolean  @default(false)
  /// Already played its chance.
  used      Boolean  @default(false)
  ip        String?
  createdAt DateTime @default(now())

  @@id([period, device])
  @@index([period, seq])
}

/// One go at the questions (answers are checked on the server).
model QuizAttempt {
  id          String    @id @default(cuid())
  token       String    @unique
  period      String
  device      String
  questionIds Json
  correct     Int?
  passed      Boolean   @default(false)
  claimed     Boolean   @default(false)
  expiresAt   DateTime
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([period])
}

/// A prize given: one coupon for one phone.
model QuizWin {
  id        String   @id @default(cuid())
  period    String
  device    String
  phone     String
  name      String?
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([period, phone])
  @@index([period])
  @@index([createdAt])
}

/* ---------------- AI features (off until OPENAI_API_KEY is set) ---------------- */

/// Saved AI answers (review summaries, "complete the look"…) so the same question isn't paid for twice.
model AiCache {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// How many AI calls each feature made per day (the owner sees the cost).
model AiUsage {
  day     DateTime @db.Date
  feature String
  count   Int      @default(0)

  @@id([day, feature])
}
