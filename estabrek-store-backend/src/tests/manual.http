  "password": "ChangeThis!123"
}

### Public: list products
GET http://localhost:4000/v1/catalog/products?page=1&pageSize=12

### Webhook echo (replace SIGNATURE)
POST http://localhost:4000/v1/webhooks/echo
x-webhook-signature: {{signature}}
content-type: application/json

{"type":"ping","id":"evt_1"}
